/* Root Layout */
#root-container {
    padding: 16px;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

/* Header */
.window-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    flex-shrink: 0;
    min-height: 96px;
    margin-bottom: 12px;
    padding: 14px;
    background-color: rgba(255, 255, 255, 0.045);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
}

.brand-block {
    min-width: 220px;
    min-height: 62px;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    margin-right: 12px;
}

.window-title {
    font-size: 21px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    padding: 0;
    background-color: transparent;
    border-radius: 0;
    white-space: normal;
    flex-shrink: 0;
}

.subtitle {
    font-size: 11px;
    color: rgba(170, 170, 170, 1);
    white-space: normal;
    flex-shrink: 0;
}

.header-status-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 2;
    flex-shrink: 1;
    min-width: 0;
    min-height: 62px;
    align-items: stretch;
}

.diagnostics-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.header-status-card {
    min-width: 96px;
    min-height: 62px;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    padding: 8px 10px;
    margin-left: 6px;
    background-color: rgba(0, 0, 0, 0.15);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
}

.endpoint-card {
    min-width: 150px;
}

.header-status-label {
    font-size: 9px;
    color: rgba(145, 145, 145, 1);
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.header-status-value {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.monospaced-value {
    font-size: 10px;
}

.status-ok {
    color: rgba(63, 199, 132, 1);
}

.status-warning {
    color: rgba(224, 174, 82, 1);
}

.status-bad {
    color: rgba(220, 88, 88, 1);
}

.status-neutral {
    color: rgba(205, 205, 205, 1);
}

/* Tabs */
.tab-toolbar {
    flex-shrink: 0;
    min-height: 30px;
    margin-bottom: 10px;
    padding-left: 0;
    background-color: transparent;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.toolbar-segment-group {
    flex-direction: row;
    align-items: stretch;
}

.tab-toolbar .toolbar-segment {
    flex-grow: 0;
    min-width: 76px;
    height: 26px;
    margin-left: 0;
    margin-right: -1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding-left: 12px;
    padding-right: 12px;
    -unity-font-style: bold;
}

.tab-toolbar .toolbar-action-button {
    min-width: 76px;
}

/* Panels */
.panel-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
    margin-top: 8px;
}

.panel-host {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
    margin-top: 8px;
    overflow: hidden;
}

.hidden {
    display: none;
}

.section-stack {
    flex-direction: column;
    flex-shrink: 1;
    min-width: 0;
}

.diagnostics-status {
    margin-top: 4px;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.diagnostics-row {
    padding: 8px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.035);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
}

.diagnostics-row-title {
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.unity-theme-light .window-header {
    background-color: rgba(0, 0, 0, 0.035);
    border-color: rgba(0, 0, 0, 0.08);
}

.unity-theme-light .header-status-card {
    background-color: rgba(255, 255, 255, 0.65);
    border-color: rgba(0, 0, 0, 0.08);
}

.unity-theme-light .subtitle {
    color: rgba(90, 90, 90, 1);
}

.unity-theme-light .header-status-label {
    color: rgba(90, 90, 90, 1);
}

.unity-theme-light .status-neutral {
    color: rgba(55, 55, 55, 1);
}
