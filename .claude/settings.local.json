{
  "permissions": {
    "allow": [
      "mcp__UnityMCP__read_console",
      "mcp__UnityMCP__manage_script"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\feishu-notify.ps1\"",
            "async": true,
            "timeout": 30,
            "statusMessage": "Sending Feishu notification..."
          }
        ]
      }
    ]
  }
}
